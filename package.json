{
  "name": "pulso-cg",
  "version": "2.1.1",
  "private": true,
  "type": "module",
  "description": "Grafismo broadcast para OBS y vMix: noticias y deportes.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "test": "node --test --test-isolation=none",
    "app": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "stress": "node tools/stress.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "Pulso CG",
  "author": "Pulso CG",
  "main": "electron/main.mjs",
  "build": {
    "appId": "com.pulsocg.app",
    "productName": "Pulso CG",
    "directories": {
      "output": "dist/2.1.1",
      "buildResources": "build"
    },
    "files": [
      "server.mjs",
      "src/**",
      "public/**",
      "electron/**",
      "package.json",
      "!**/*.map",
      "build/icon.png"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.video",
      "icon": "build/icon.png",
      "artifactName": "Pulso-CG-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "Pulso CG"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Pulso CG",
      "artifactName": "Pulso-CG-${version}-Windows-Setup.exe"
    },
    "linux": {
      "target": "AppImage",
      "category": "Video"
    }
  }
}
